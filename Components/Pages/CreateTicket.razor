@page "/tickets/new"
@rendermode InteractiveServer
@inject IDbContextFactory<HelpdeskContext> DbFactory
@inject NavigationManager Nav

<PageTitle>New Ticket</PageTitle>

<h1>New Ticket</h1>

<EditForm Model="newTicket" OnValidSubmit="HandleCreate">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="ticket-form">
        <div class="field-group">
            <label>Title</label>
            <InputText class="form-control" @bind-Value="newTicket.Title" placeholder="Short summary of the issue" />
            <ValidationMessage For="@(() => newTicket.Title)" />
        </div>

        <div class="field-group">
            <label>Description</label>
            <InputTextArea class="form-control" @bind-Value="newTicket.Description" placeholder="What's happening, and since when" />
            <ValidationMessage For="@(() => newTicket.Description)" />
        </div>

        <div class="field-group">
            <label>Requester name</label>
            <InputText class="form-control" @bind-Value="newTicket.RequesterName" placeholder="Full name" />
            <ValidationMessage For="@(() => newTicket.RequesterName)" />
        </div>

        <div class="field-group">
            <label>Priority</label>
            <InputSelect class="form-control" @bind-Value="newTicket.Priority">
                @foreach (var priority in Enum.GetValues<TicketPriority>())
                {
                    <option value="@priority">@priority</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Submit Ticket</button>
    </div>
</EditForm>

@if (errorMessage is not null)
{
    <p class="text-danger">@errorMessage</p>
}

@code {
    private Ticket newTicket = new();
    private string? errorMessage;

    private async Task HandleCreate()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            db.Tickets.Add(newTicket);
            await db.SaveChangesAsync();
            Nav.NavigateTo($"/tickets/{newTicket.Id}");
        }
        catch (Exception)
        {
            errorMessage = "Could not create the ticket. Please try again.";
        }
    }
}