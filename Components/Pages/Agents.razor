@page "/agents"
@rendermode InteractiveServer
@inject IDbContextFactory<HelpdeskContext> DbFactory

<PageTitle>Agents</PageTitle>

<h1>Agents</h1>

@if (agents is null)
{
    <p>Loading…</p>
}
else
{
    <div class="agent-list">
        @foreach (var agent in agents)
        {
            <div class="agent-row">
                <span class="avatar-circle">@Initials(agent.Name)</span>
                @agent.Name
            </div>
        }
    </div>
}

<EditForm Model="newAgent" OnValidSubmit="HandleAdd">
    <DataAnnotationsValidator />
    <div class="add-agent-bar">
        <InputText class="form-control" @bind-Value="newAgent.Name" placeholder="New agent name" />
        <button type="submit" class="btn btn-primary">Add Agent</button>
    </div>
    <ValidationMessage For="@(() => newAgent.Name)" />
</EditForm>

@code {
    private List<Agent>? agents;
    private Agent newAgent = new();

    protected override async Task OnInitializedAsync() => await LoadAgents();

    private async Task LoadAgents()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        agents = await db.Agents.OrderBy(a => a.Name).ToListAsync();
    }

    private async Task HandleAdd()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Agents.Add(newAgent);
        await db.SaveChangesAsync();
        newAgent = new();
        await LoadAgents();
    }

    private string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}